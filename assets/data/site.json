    "qa": {
      "eval": 5347,
      "groups": [
        "Perception",
        "Understanding",
        "Planning"
      ],
      "tasks": [
        {
          "group": "Perception",
          "id": "V1",
          "name": "Visible component boxes",
          "asks": "Every part visible in one image, with its class and box.",
          "scored": "F1 over class-and-box matches at IoU 0.5 or more.",
          "n": 300
        },
        {
          "group": "Perception",
          "id": "V8",
          "name": "Component grounding",
          "asks": "The box of a part named in the question.",
          "scored": "Hit when the box overlaps the true box at IoU 0.5 or more.",
          "n": 300
        },
        {
          "group": "Perception",
          "id": "V2",
          "name": "Component state or screw count",
          "asks": "The state of a marked part, or \"cannot tell\" when the image does not show it; or how many screws of one kind are still in place.",
          "scored": "Exact match; a screw count that is off by one earns partial credit.",
          "n": 300
        },
        {
          "group": "Perception",
          "id": "V15",
          "name": "Same step across views",
          "asks": "Whether two images from two cameras show the same step.",
          "scored": "Accuracy.",
          "n": 400
        },
        {
          "group": "Understanding",
          "id": "V3",
          "name": "Observed operation",
          "asks": "What was done between two moments: the operation and the part it was done to; asked without a hint, with a hint box, and over a span of steps.",
          "scored": "Correct when verb and target are both right; over a span, F1 over the action groups.",
          "n": 900
        },
        {
          "group": "Understanding",
          "id": "V12",
          "name": "State change",
          "asks": "Whether anything changed between two moments, from neighbouring steps to several steps apart.",
          "scored": "Accuracy.",
          "n": 800
        },
        {
          "group": "Understanding",
          "id": "V10",
          "name": "Completed operations",
          "asks": "Which operations have been carried out so far, and how far the disassembly has got.",
          "scored": "F1 over the completed and started operations; accuracy of the progress bin.",
          "n": 300
        },
        {
          "group": "Planning",
          "id": "V4",
          "name": "Proposed action feasibility",
          "asks": "Whether an action on a marked part can be done now and, if not, which parts have to be dealt with first.",
          "scored": "Accuracy of the yes or no; F1 over the parts named as blocking.",
          "n": 400
        },
        {
          "group": "Planning",
          "id": "V6",
          "name": "Next feasible action",
          "asks": "Every action that can be done now; also as multiple choice, and under one added rule.",
          "scored": "F1 over the groups of feasible actions; accuracy for the multiple choice.",
          "n": 747
        },
        {
          "group": "Planning",
          "id": "V7",
          "name": "Removal plan",
          "asks": "A plan that takes a named part out, free or under one added rule.",
          "scored": "The plan is replayed on the relations: valid, goal reached, recall of the required steps.",
          "n": 600
        },
        {
          "group": "Planning",
          "id": "V16",
          "name": "Proposed plan validity",
          "asks": "Whether a proposed sequence of actions can be carried out, and the first step that cannot.",
          "scored": "Replayed step by step on the relations: accuracy of the validity and of the first wrong step.",
          "n": 300
        }
      ]
    }
  },
